{
  "name": "pycharm-evaluate",
  "displayName": "PyCharm-like Evaluate Expression",
  "description": "Multi-line expression evaluation panel for debugging, inspired by PyCharm's Evaluate Expression dialog",
  "version": "1.4.1",
  "icon": "images/icon.png",
  "publisher": "nunezbenj",
  "repository": {
    "type": "git",
    "url": "https://github.com/nunezbenj/vscode-evaluate-expression.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "evaluate",
    "expression",
    "debug",
    "pycharm",
    "multi-line",
    "python",
    "javascript",
    "typescript",
    "node"
  ],
  "activationEvents": [
    "onDebug"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "evaluate.openPanel",
        "title": "Evaluate: Open Panel",
        "icon": {
          "light": "media/icons/evaluate-light.svg",
          "dark": "media/icons/evaluate-dark.svg"
        }
      },
      {
        "command": "evaluate.runSelection",
        "title": "Evaluate: Run Selection"
      },
      {
        "command": "evaluate.addWatch",
        "title": "Evaluate: Add Selection to Watches"
      },
      {
        "command": "evaluate.refreshWatches",
        "title": "Evaluate: Refresh Watches"
      },
      {
        "command": "evaluate.showLog",
        "title": "Evaluate: Show Debug Log"
      },
      {
        "command": "evaluate.copyLog",
        "title": "Evaluate: Copy Debug Log to Clipboard"
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "command": "evaluate.openPanel",
          "when": "inDebugMode",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "evaluate.runSelection",
          "when": "debugState == 'stopped' && editorHasSelection",
          "group": "9_evaluate"
        },
        {
          "command": "evaluate.addWatch",
          "when": "debugState == 'stopped' && editorHasSelection",
          "group": "9_evaluate"
        }
      ]
    },
    "configuration": {
      "title": "Evaluate Expression",
      "properties": {
        "evaluate.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose logging for debugging. Logs full expression code and DAP responses to the Output channel."
        },
        "evaluate.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show 'Evaluate Selection' and 'Add to Watches' CodeLens links above selected code during debugging."
        },
        "evaluate.autoRefreshVariables": {
          "type": "boolean",
          "default": true,
          "description": "After an evaluation, refresh the Variables panel automatically (via a no-op Set Next Statement to the current line). Disable if your debug adapter misbehaves on goto requests."
        }
      }
    },
    "keybindings": [
      {
        "command": "evaluate.openPanel",
        "key": "ctrl+alt+e",
        "when": "debugState == 'stopped'"
      },
      {
        "command": "evaluate.openPanel",
        "key": "ctrl+shift+f8",
        "when": "debugState == 'stopped'"
      },
      {
        "command": "evaluate.runSelection",
        "key": "ctrl+alt+enter",
        "when": "debugState == 'stopped' && editorHasSelection"
      },
      {
        "command": "evaluate.runSelection",
        "key": "ctrl+shift+f9",
        "when": "debugState == 'stopped' && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:webview": "esbuild media/panel-src.js --bundle --outfile=media/panel.js --format=iife --platform=browser",
    "compile": "tsc -p ./ && npm run build:webview",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "mocha"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.3",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2"
  }
}
